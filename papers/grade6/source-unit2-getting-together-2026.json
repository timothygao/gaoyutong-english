      "explain": "sing 的过去式 sang。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-13",
      "prompt": "We ___ cards for our friends. (make)",
      "answer": "made",
      "explain": "make 的过去式 made。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-14",
      "prompt": "They ___ down at midnight. (count down)",
      "answer": "counted",
      "explain": "count down→counted down。",
