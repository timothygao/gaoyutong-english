    },
    {
      "id": "unit2-getting-together-grammar-15",
      "prompt": "He ___ books to the children yesterday. (read)",
      "answer": "read",
      "explain": "read 的原形和过去式拼写相同，读音不同（后半句为补充解释）。",
      "type": "语法拓展"
