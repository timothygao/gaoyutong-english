  "grammar": [
    {
      "id": "unit2-getting-together-grammar-1",
      "prompt": "问过去是否旅行：___ you take a trip?",
      "answer": "Did",
      "explain": "一般过去时一般疑问句 Did + 主语 + 动词原形？",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-2",
      "prompt": "No, we ___.",
      "answer": "didn't",
      "explain": "否定简答用 didn't。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-3",
      "prompt": "___ you eat mooncakes?",
      "answer": "Did",
      "explain": "询问过去是否做过某事，用 Did。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-4",
      "prompt": "Yes, we ___.",
      "answer": "did",
      "explain": "肯定简答用 did。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-5",
      "prompt": "Did you ___ the race? (watch)",
      "answer": "watch",
      "explain": "did 后的主要动词用原形。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-6",
      "prompt": "My mother and I ___ to a marathon on Sunday. (go)",
      "answer": "went",
      "explain": "go 的过去式 went。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-7",
      "prompt": "What ___ you like about it?",
      "answer": "did",
      "explain": "What did 主语 like about ... ?",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-8",
      "prompt": "I ___ watching the runners. (like)",
      "answer": "liked",
      "explain": "过去的喜好用 liked；后接 -ing。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-9",
      "prompt": "I liked ___ the runners. (watch)",
      "answer": "watching",
      "explain": "liked + 动词 -ing。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-10",
      "prompt": "We ___ in red at the festival. (dress in)",
      "answer": "dressed",
      "explain": "清单：dress in→dressed in。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-11",
      "prompt": "She ___ beautiful clothes yesterday. (wear)",
      "answer": "wore",
      "explain": "wear 的过去式 wore。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit2-getting-together-grammar-12",
      "prompt": "They ___ songs at the art festival. (sing)",
