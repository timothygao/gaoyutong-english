  "grammar": [
    {
      "id": "unit1-amazing-places-grammar-1",
      "prompt": "询问过去情况：___ was your weekend?",
      "answer": "How",
      "explain": "课本句型 How was/were + 主语?",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-2",
      "prompt": "上周末怎么样？It ___ great!",
      "answer": "was",
      "explain": "过去状态使用 was/were。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-3",
      "prompt": "问过去做了什么：What ___ you do, Leo?",
      "answer": "did",
      "explain": "特殊疑问词 + did + 主语 + 动词原形。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-4",
      "prompt": "Did you ___ the Great Wall last weekend?",
      "answer": "climb",
      "explain": "did 后面要用动词原形。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-5",
      "prompt": "I ___ the Great Wall last weekend. (climb)",
      "answer": "climbed",
      "explain": "描述过去动作，用动词过去式。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-6",
      "prompt": "Where ___ you go over the summer holidays?",
      "answer": "did",
      "explain": "询问过去地点用 Where did ... go?",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-7",
      "prompt": "I ___ to Xi'an with my family. (go)",
      "answer": "went",
      "explain": "go 的过去式是 went。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-8",
      "prompt": "We ___ to see the Terracotta Warriors. (go)",
      "answer": "went",
      "explain": "过去去参观兵马俑，用 went。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-9",
      "prompt": "We ___ many beautiful wall paintings. (see)",
      "answer": "saw",
      "explain": "see 的过去式 saw。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-10",
      "prompt": "She ___ nice photos on her trip. (take)",
      "answer": "took",
      "explain": "take 的过去式 took。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-11",
      "prompt": "They ___ around the village yesterday. (walk)",
      "answer": "walked",
      "explain": "规则动词一般加 -ed。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-12",
      "prompt": "We ___ an old restaurant last Saturday. (visit)",
      "answer": "visited",
      "explain": "visit 的过去式 visited。",
      "type": "清单句型与语法"
    },
    {
      "id": "unit1-amazing-places-grammar-13",
      "prompt": "He ___ at the airport yesterday. (is)",
